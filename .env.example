# Copy to .env and adjust. All values have sensible local defaults.
# Docker Compose reads this file automatically.

# ---- Application ----
# Host port the frontend (and full app) is served on.
APP_PORT=8080

# ---- PostgreSQL ----
POSTGRES_USER=selfdocs
POSTGRES_PASSWORD=selfdocs
POSTGRES_DB=selfdocs
# Host port for direct database access (optional, for inspection).
POSTGRES_PORT=5432

# ---- Private Archive ----
# bcrypt hash of the master password. Seed it once at first boot; leave empty to
# configure later from the Settings page. Generate with:
#   htpasswd -bnBC 10 "" 'your-password' | tr -d ':\n'
MASTER_PASSWORD_HASH=

# ---- Optional Redis cache ----
# Set to redis://cache:6379 and start with `docker compose --profile cache up`.
REDIS_URL=

# ---- CORS ----
# Origin allowed to call the API. Defaults to the app's own origin.
CORS_ORIGINS=http://localhost:8080
