# PostgreSQL connection string (required).
DATABASE_URL=postgres://selfdocs:selfdocs@localhost:5432/selfdocs?sslmode=disable

# HTTP listen port (default 8080).
PORT=8080

# bcrypt/argon2 hash for the Private Archive master password. Optional at boot;
# when empty the hash can be set later via the settings API.
MASTER_PASSWORD_HASH=

# Optional Redis URL. Leave empty to run without cache (PRD 2).
REDIS_URL=

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
